local Players = game:GetService("Players")

local function updatePlayerList()
    -- 1. Build list of current player names (exclude local player)
    local names = {}
    local localPlayer = Players.LocalPlayer
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer then
            table.insert(names, plr.Name)
        end
    end

    -- 2. Get current selections and filter out those who left
    local currentSelections = library.flags["rage_target_players"] or {}
    local validSelections = {}
    for _, selected in ipairs(currentSelections) do
        for _, name in ipairs(names) do
            if name == selected then
                table.insert(validSelections, selected)
                break
            end
        end
    end

    -- 3. Refresh dropdown options
    playerDropdown:refresh_options(names)

    -- 4. Re-apply valid selections
    if #validSelections > 0 then
        playerDropdown:set(validSelections)
    else
        -- Auto-select first player if any, otherwise clear selection
        if #names > 0 then
            playerDropdown:set({names[1]})
        else
            playerDropdown:set({})
        end
    end
end

-- Initial population
